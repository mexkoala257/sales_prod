# ─────────────────────────────────────────────────────────────────────────────
# Multi-Brand Platform — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values before running docker compose.
#
#   cp .env.example .env
#
# Lines starting with # are comments. Values marked REQUIRED must be set.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL database name (created automatically by the postgres container)
POSTGRES_DB=platform

# PostgreSQL username (created automatically by the postgres container)
POSTGRES_USER=platform

# PostgreSQL password — REQUIRED. Choose a strong random value.
# Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=


# ── Application Secrets ───────────────────────────────────────────────────────

# Secret key used to sign JWT auth tokens — REQUIRED. Must be kept private.
# Generate one: openssl rand -base64 48
SESSION_SECRET=

# ── First Super-Admin Bootstrap (one-time only) ───────────────────────────────
#
# Do not add administrator credentials to this file. For a clean VPS install,
# export the following two values only in the shell session where you run:
#   docker compose --profile tools run --rm bootstrap-admin
#
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=


# ── Web Server ────────────────────────────────────────────────────────────────

# Host port the web (Nginx) container binds to.
# Change if port 80 is already in use (e.g. when putting a host Nginx in front).
WEB_PORT=80


# ── Logging ───────────────────────────────────────────────────────────────────

# API server log level. Options: trace | debug | info | warn | error | fatal
LOG_LEVEL=info


# ── Custom Domain Routing ─────────────────────────────────────────────────────

# The hostname where the platform admin UI is served, e.g. platform.example.com.
# REQUIRED for self-hosted deployments.  This value is baked into the React SPA
# bundle at build time (Vite inlines it via import.meta.env.VITE_PLATFORM_HOST)
# so the browser can distinguish the platform's own hostname from the custom
# brand domains assigned to individual storefronts.
#
# Without this, visiting the platform's root URL on a custom hostname causes the
# SPA to enter "custom domain mode" and render "Store not found" instead of the
# storefront list / admin login page.
#
# If left blank the SPA falls back to detecting localhost and *.replit.* patterns
# only, which is correct for local development but not for production.
VITE_PLATFORM_HOST=


# ── Object Storage (Replit-only feature) ──────────────────────────────────────
# B2B artwork uploads use Replit Object Storage, which authenticates via
# Replit's local sidecar (http://127.0.0.1:1106). This sidecar is only
# present inside the Replit runtime and cannot be replicated on a VPS.
#
# On self-hosted deployments artwork upload endpoints will return an error;
# all other platform features work normally.
#
# These variables are kept here for documentation purposes only and are
# not read by the docker-compose services.
#
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# PRIVATE_OBJECT_DIR=uploads/private
# PUBLIC_OBJECT_SEARCH_PATHS=uploads/public
