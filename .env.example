# ─────────────────────────────────────────────────────────────────────────────
# Multi-Brand Platform — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values before running docker compose.
#
#   cp .env.example .env
#
# Lines starting with # are comments. Values marked REQUIRED must be set.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL database name (created automatically by the postgres container)
POSTGRES_DB=platform

# PostgreSQL username (created automatically by the postgres container)
POSTGRES_USER=platform

# PostgreSQL password — REQUIRED. Choose a strong random value.
# Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=


# ── Application Secrets ───────────────────────────────────────────────────────

# Secret key used to sign JWT auth tokens — REQUIRED. Must be kept private.
# Generate one: openssl rand -base64 48
SESSION_SECRET=


# ── Web Server ────────────────────────────────────────────────────────────────

# Host port the web (Nginx) container binds to.
# Change if port 80 is already in use (e.g. when putting a host Nginx in front).
WEB_PORT=80


# ── Logging ───────────────────────────────────────────────────────────────────

# API server log level. Options: trace | debug | info | warn | error | fatal
LOG_LEVEL=info


# ── Object Storage (Replit-only feature) ──────────────────────────────────────
# B2B artwork uploads use Replit Object Storage, which authenticates via
# Replit's local sidecar (http://127.0.0.1:1106). This sidecar is only
# present inside the Replit runtime and cannot be replicated on a VPS.
#
# On self-hosted deployments artwork upload endpoints will return an error;
# all other platform features work normally.
#
# These variables are kept here for documentation purposes only and are
# not read by the docker-compose services.
#
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# PRIVATE_OBJECT_DIR=uploads/private
# PUBLIC_OBJECT_SEARCH_PATHS=uploads/public
